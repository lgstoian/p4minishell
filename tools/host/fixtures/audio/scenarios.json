{
  "tag": "audio.engine.v160",
  "_comment": [
    "Hardware-free audio engine fixture. Numbers are LITERAL expectations: the",
    "Python gate transcribes them into a C harness that calls the REAL",
    "components/audio/audio_engine.c. It never re-implements the mixer."
  ],
  "sample_rate": 1000,
  "envs": {
    "flat": { "attack_ms": 0, "decay_ms": 0, "sustain_pct": 100, "release_ms": 0 },
    "pluck": { "attack_ms": 5, "decay_ms": 20, "sustain_pct": 40, "release_ms": 40 }
  },
  "parsers": [
    {
      "name": "env.flat",
      "kind": "env",
      "input": "flat",
      "expect_ok": true,
      "expect": { "attack_ms": 0, "decay_ms": 0, "sustain_pct": 100, "release_ms": 0 }
    },
    {
      "name": "env.numeric",
      "kind": "env",
      "input": "5,20,40,40",
      "expect_ok": true,
      "expect": { "attack_ms": 5, "decay_ms": 20, "sustain_pct": 40, "release_ms": 40 }
    },
    {
      "name": "env.reject_short",
      "kind": "env",
      "input": "1,2,3",
      "expect_ok": false
    },
    {
      "name": "env.reject_overflow",
      "kind": "env",
      "input": "1,2,101,3",
      "expect_ok": false
    },
    {
      "name": "seq.absolute_samples",
      "kind": "seq",
      "input": "440:100@250:80",
      "expect_ok": true,
      "expect": { "start_sample": 250, "length_samples": 100, "freq_hz": 440, "gain_pct": 80 }
    },
    {
      "name": "seq.default_gain",
      "kind": "seq",
      "input": "660:50@350",
      "expect_ok": true,
      "expect": { "start_sample": 350, "length_samples": 50, "freq_hz": 660, "gain_pct": 100 }
    },
    {
      "name": "seq.reject_junk",
      "kind": "seq",
      "input": "440:100@250:junk",
      "expect_ok": false
    }
  ],
  "mixes": [
    {
      "name": "mix.two_buses",
      "gain_pct": 100,
      "duck_pct": 100,
      "duck_attack_ms": 0,
      "duck_release_ms": 0,
      "frames": 4,
      "channels": [
        { "start": 0, "values": [1000, 2000, 3000, 4000], "repeat": 1, "gain": 100, "bus": "music", "env": "flat" },
        { "start": 0, "values": [500, 500, 500, 500], "repeat": 1, "gain": 100, "bus": "sfx", "env": "flat" }
      ],
      "expect_left": [1500, 2500, 3500, 4500],
      "baseline": "baseline/mix_two_buses.hex"
    },
    {
      "name": "mix.half_master",
      "gain_pct": 50,
      "duck_pct": 100,
      "duck_attack_ms": 0,
      "duck_release_ms": 0,
      "frames": 2,
      "channels": [
        { "start": 0, "values": [10000, 10000], "repeat": 1, "gain": 100, "bus": "music", "env": "flat" }
      ],
      "expect_left": [5000, 5000],
      "baseline": "baseline/mix_half_master.hex"
    },
    {
      "name": "clip.saturates",
      "gain_pct": 100,
      "duck_pct": 100,
      "duck_attack_ms": 0,
      "duck_release_ms": 0,
      "frames": 1,
      "channels": [
        { "start": 0, "values": [30000], "repeat": 1, "gain": 100, "bus": "music", "env": "flat" },
        { "start": 0, "values": [30000], "repeat": 1, "gain": 100, "bus": "sfx", "env": "flat" }
      ],
      "expect_left": [32767],
      "baseline": "baseline/clip_saturates.hex"
    },
    {
      "name": "duck.sfx_window",
      "gain_pct": 100,
      "duck_pct": 25,
      "duck_attack_ms": 0,
      "duck_release_ms": 0,
      "frames": 6,
      "channels": [
        { "start": 0, "values": [10000], "repeat": 10, "gain": 100, "bus": "music", "env": "flat" },
        { "start": 2, "values": [10000], "repeat": 2, "gain": 100, "bus": "sfx", "env": "flat" }
      ],
      "expect_left": [10000, 10000, 12500, 12500, 10000, 10000],
      "baseline": "baseline/duck_sfx_window.hex"
    },
    {
      "name": "env.adsr_probes",
      "gain_pct": 100,
      "duck_pct": 100,
      "duck_attack_ms": 0,
      "duck_release_ms": 0,
      "frames": 130,
      "channels": [
        { "start": 0, "values": [10000], "repeat": 85, "gain": 100, "bus": "music", "env": "pluck" }
      ],
      "probes": [
        { "frame": 0, "expect": 0 },
        { "frame": 2, "expect": 3999 },
        { "frame": 5, "expect": 10000 },
        { "frame": 10, "expect": 8500 },
        { "frame": 30, "expect": 3999 },
        { "frame": 40, "expect": 3999 },
        { "frame": 80, "expect": 3999 },
        { "frame": 100, "expect": 2500 },
        { "frame": 125, "expect": 0 }
      ]
    }
  ],
  "sequence": {
    "events": ["440:100@250:80", "660:50@350"],
    "expect": [
      { "start_sample": 250, "length_samples": 100, "freq_hz": 440, "gain_pct": 80 },
      { "start_sample": 350, "length_samples": 50, "freq_hz": 660, "gain_pct": 100 }
    ],
    "expect_length_samples": 400,
    "silent_prefix_frames": 4,
    "active_probe_start": 250,
    "active_probe_frames": 4
  },
  "bounded": {
    "adds": 9,
    "expect_indices": [0, 1, 2, 3, 4, 5, 6, 7, -1],
    "expect_count": 8
  },
  "meter": {
    "frames": 2,
    "sample_count": 4,
    "values": [1000, -1000, 1000, -1000],
    "expect_peak": 1000,
    "expect_rms": 1000
  },
  "offline": {
    "frames": 8,
    "values": [5000, 5000, 5000, 5000, 5000, 5000, 5000, 5000],
    "split": 3,
    "expect_sample": 5000
  }
}
