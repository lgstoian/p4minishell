build/
test/build/
.vscode/
__pycache__/
*.pyc
.DS_Store
sdkconfig
sdkconfig.old
# Per-board generated sdkconfig (sdkconfig.<P4_BOARD>); keep sdkconfig.defaults.
sdkconfig.*
!sdkconfig.defaults
*.bak
managed_components/idf_component_manager.lock

# Machine-local board <-> COM port map written by tools/board_ports.py.
tools/board_ports.json

# Generated by the component manager for the unit-test project
test/managed_components/

# Local HW-test artifacts are never committed. Both folders exist in the repo
# only to hold the generated files at run time; every other entry is ignored.
screenshots/*
!screenshots/.gitkeep
spikes/*
!spikes/.gitkeep
assets_out/
tools/*.log
apps/*.log

# Icon master (16384x16384, ~70 MB). The committed derivatives are
# icon/icon-512.png (readme) and main/assets/icon_splash.c (firmware splash);
# regenerate them with tools/make_icon.py from this master.
icon/icon.png
