@echo off
rem =====================================================================
rem  SYS.BAT - Live System dashboard.
rem  Uses TUI fullscreen with draw boxes for each panel, falls back to
rem  appmode if TUI not available. Shows sysinfo, mem, ps, battery, wifi.
rem =====================================================================

:main
tui fullscreen on
draw clear screen
draw box 1 1 80 3 single
draw text 28 2 "LIVE SYSTEM DASHBOARD" 14
draw box 1 4 80 10 single "System"
draw box 1 15 40 10 single "Memory"
draw box 41 15 40 10 single "Tasks"
call LIB.BAT::banner
call LIB.BAT::hr
ansi 1;33m  LIVE SYSTEM DASHBOARD (TUI)
call LIB.BAT::hr
sysinfo > _sys.txt
type _sys.txt
del /p _sys.txt
echo.
mem > _mem.txt
type _mem.txt
del /p _mem.txt
echo.
ps /O:C | more
echo.
battery
echo.
wifi status
echo.
:refresh
list "Dashboard" "Refresh" "View details" "Save snapshot" "Back"
if errorlevel 255 goto :back
if errorlevel 3 goto :save
if errorlevel 2 goto :back
if errorlevel 1 goto :view_details
if errorlevel 0 goto :do_refresh
goto refresh
:do_refresh
draw clear screen
draw box 1 1 80 3 single
draw text 28 2 "LIVE SYSTEM DASHBOARD" 14
draw box 1 4 80 10 single "System"
draw box 1 15 40 10 single "Memory"
draw box 41 15 40 10 single "Tasks"
sysinfo > _sys2.txt
type _sys2.txt
del /p _sys2.txt
echo.
mem > _mem2.txt
type _mem2.txt
del /p _mem2.txt
echo.
ps /O:C | more
echo.
battery
echo.
wifi status
echo.
goto refresh
:view_details
dialog "Details" "Heap, tasks and uptime shown above. Use Save to keep a snapshot." "OK"
goto refresh
:save
sysinfo > SYS_SNAP.TXT
mem >> SYS_SNAP.TXT
ps /O:C >> SYS_SNAP.TXT
dialog "Saved" "Snapshot saved to SYS_SNAP.TXT" "OK"
goto refresh
:back
tui fullscreen off
draw clear screen
goto :eof
