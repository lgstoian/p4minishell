; APPINFO metadata for the P4 Companion (INI format, read by the `launch`
; command). Copied to sd:/APPS/COMPANION.APPINFO by push_sd.py.
title=P4 Companion
description=A pure-batch system helper: dashboard, files, network, games, settings
version=1.0
; Opt-in transparency (v1.4.3): translucent menu/dashboard + modal scrim.
; The sub-apps inherit these values while they run inside Companion; each also
; ships its own APPINFO for a standalone `launch SYS|FILES|NET|FUN|SET`.
alpha=94%
scrim=45%
