menu "P4MiniShell"

config P4MINISHELL_WIFI_DEFAULT_SSID
    string "Default Wi-Fi SSID"
    default ""
    help
        Default station SSID used when the shell command `wifi connect` is
        entered without explicit credentials.

config P4MINISHELL_WIFI_DEFAULT_PASSWORD
    string "Default Wi-Fi password"
    default ""
    help
        Default station password used when the shell command `wifi connect` is
        entered without explicit credentials.

config P4MINISHELL_WIFI_BOOT_DIAGNOSTIC
    bool "Run Wi-Fi diagnostic scan at boot"
    default n
    help
        When enabled, the boot-time Wi-Fi background task performs a scan and
        prints a diagnostic report. On esp_hosted 2.12.1 with IDF 5.5.5 this
        scan frequently corrupts heap metadata and crashes the board during a
        later station connect, so it is disabled by default. The `wifi diag`
        command can still be run manually.

endmenu
